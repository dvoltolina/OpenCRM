{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase-demo.json",
      "**/.*",
      "**/node_modules/**",
      "docs/**",
      "functions/**",
      "lib/**",
      "src/**",
      "tests/**",
      "*.md"
    ],
    "headers": [
      {
        "source": "**/*.@(html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(css|js|svg|png|jpg|jpeg|webp|ico|woff|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false
  }
}
