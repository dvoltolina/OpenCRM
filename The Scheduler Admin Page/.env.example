# Firebase Configuration (leave blank until populated from your Firebase project)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Optional: Use function stubs instead of real Cloud Functions (for development)
# VITE_USE_FUNCTION_STUBS=true

# Demo mode (public read-only product demo)
# Use a separate Firebase project with read-only rules and fake seeded data.
# VITE_DEMO_MODE=true
# VITE_DEMO_BUSINESS_ID=demo-business-001
# VITE_DEMO_FIREBASE_API_KEY=
# VITE_DEMO_FIREBASE_AUTH_DOMAIN=
# VITE_DEMO_FIREBASE_PROJECT_ID=
# VITE_DEMO_FIREBASE_APP_ID=
# VITE_DEMO_FIREBASE_MESSAGING_SENDER_ID=
# VITE_DEMO_FIREBASE_STORAGE_BUCKET=
# VITE_DEMO_SIGN_UP_URL=/signup

# Billing & Stripe (frontend-safe)
# Publishable key is safe for the browser. Secret keys + webhook secrets belong in Firebase Functions config:
# firebase functions:config:set stripe.secret_key=\"sk_test_...\" stripe.webhook_secret=\"whsec_...\"
VITE_STRIPE_PUBLISHABLE_KEY=
# If billing endpoints are hosted separately from Firebase callable functions, point to that base URL.
# Otherwise, leave empty to use the default Firebase Functions instance.
VITE_BILLING_API_BASE_URL=
# Public URL that Stripe should redirect to after checkout (used by onboarding flow if needed)
VITE_BILLING_RETURN_URL=
