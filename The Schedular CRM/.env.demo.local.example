# Demo-only Firebase project configuration for the CRM demo build.
# Never point these values at production.

VITE_DEMO_MODE=true
VITE_DEMO_BUSINESS_ID=demo-business-001
VITE_DEMO_USER_EMAIL=owner@demo.example.com
VITE_DEMO_USER_NAME=Avery Demo
VITE_DEMO_SIGN_UP_URL=https://your-firebase-project.web.app/demo.html
VITE_DEMO_FIREBASE_API_KEY=
VITE_DEMO_FIREBASE_AUTH_DOMAIN=demo-project.firebaseapp.com
VITE_DEMO_FIREBASE_PROJECT_ID=demo-project-id
VITE_DEMO_FIREBASE_STORAGE_BUCKET=demo-project.appspot.com
VITE_DEMO_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_DEMO_FIREBASE_APP_ID=
VITE_DEMO_HOSTS=crm.example.com

# Optional backend overrides. Leave unset unless you intentionally point
# them at demo-only infrastructure.
