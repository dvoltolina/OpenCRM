{
  "name": "scheduler-crm",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.app.json tsconfig.node.json && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=$(printf '%s' \"${NODE_OPTIONS}\" | sed 's/--localstorage-file[^ ]*//g') vitest",
    "test:run": "NODE_OPTIONS=$(printf '%s' \"${NODE_OPTIONS}\" | sed 's/--localstorage-file[^ ]*//g') vitest run",
    "test:coverage": "NODE_OPTIONS=$(printf '%s' \"${NODE_OPTIONS}\" | sed 's/--localstorage-file[^ ]*//g') vitest run --coverage",
    "test:rules": "NODE_OPTIONS=$(printf '%s' \"${NODE_OPTIONS}\" | sed 's/--localstorage-file[^ ]*//g') vitest run tests/firestore-rules/",
    "test:security": "NODE_OPTIONS=$(printf '%s' \"${NODE_OPTIONS}\" | sed 's/--localstorage-file[^ ]*//g') vitest run test/security/",
    "test:audit": "NODE_OPTIONS=$(printf '%s' \"${NODE_OPTIONS}\" | sed 's/--localstorage-file[^ ]*//g') vitest run test/security/audit_logging.test.ts",
    "check:phi": "npx tsx scripts/check-logs-for-phi.ts",
    "check:security": "npm run check:phi && npm run test:security",
    "validate:firestore": "npx tsx scripts/validate-firestore-config.ts",
    "perf:hooks": "npx tsx scripts/perf/profile-hooks.ts",
    "ui:mobile": "node scripts/ui/mobile-smoke.js",
    "ui:reports": "npx tsx scripts/ui/reports-smoke.ts",
    "ui:manager": "npx tsx scripts/ui/manager-smoke.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.59.16",
    "@types/leaflet": "^1.9.21",
    "firebase": "^12.6.0",
    "leaflet": "^1.9.4",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.9.6",
    "recharts": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/papaparse": "^5.5.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/recharts": "^1.8.29",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^3.2.4",
    "baseline-browser-mapping": "^2.10.10",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "playwright-chromium": "^1.57.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^3.2.4"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
