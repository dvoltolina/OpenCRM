# ==============================================================================
# The Scheduler CRM - Environment Configuration
# ==============================================================================
#
# SECURITY NOTICE:
# - NEVER commit the .env file to git
# - NEVER share credentials or API keys
# - Use different values for development, staging, and production
# - All client-side environment variables MUST be prefixed with VITE_
#
# PRODUCTION REQUIREMENTS:
# - The core VITE_FIREBASE_* variables are required for production deployment
# - Additional variables below are feature-specific and only required when that surface is enabled
# - scripts/validate-env.ts validates the core frontend Firebase contract before deployment
#
# ==============================================================================

# ------------------------------------------------------------------------------
# Firebase Configuration (REQUIRED)
# ------------------------------------------------------------------------------
# Get these values from Firebase Console → Project Settings → General
# https://console.firebase.google.com/project/YOUR_PROJECT/settings/general

# Firebase API Key (public, safe to expose client-side)
VITE_FIREBASE_API_KEY=

# Firebase Auth Domain (must end with .firebaseapp.com or .web.app)
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# Firebase Project ID (lowercase letters, numbers, hyphens only)
VITE_FIREBASE_PROJECT_ID=your-project-id

# Firebase Storage Bucket (must end with .appspot.com or .firebasestorage.app)
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Firebase Messaging Sender ID (numeric string)
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# Firebase App ID (format: 1:xxxxx:web:xxxxx)
VITE_FIREBASE_APP_ID=your-app-id

# Cloud Functions base URL (for CRM integrations/import/export/sync)
VITE_FUNCTIONS_BASE_URL=https://us-central1-your-project.cloudfunctions.net

# ------------------------------------------------------------------------------
# Optional Firebase Configuration
# ------------------------------------------------------------------------------

# Firebase Analytics Measurement ID (for Google Analytics)
# VITE_FIREBASE_MEASUREMENT_ID=YOUR_ANALYTICS_ID

# ------------------------------------------------------------------------------
# Demo Mode Configuration (OPTIONAL / DEMO-ONLY)
# ------------------------------------------------------------------------------
# Use a dedicated Firebase demo project with fake seed data only.
# When VITE_DEMO_MODE=true, the app switches to the VITE_DEMO_FIREBASE_* values below.

# Enable the unauthenticated read-only buyer demo
# VITE_DEMO_MODE=true

# Shared demo workspace ID seeded by scripts/seed-demo-data.ts
# VITE_DEMO_BUSINESS_ID=demo-business-001

# Optional CTA target for the demo banner/sidebar
# VITE_DEMO_SIGN_UP_URL=https://www.example.com/get-started

# Demo Firebase client config (must point at the isolated demo project)
# VITE_DEMO_FIREBASE_API_KEY=
# VITE_DEMO_FIREBASE_AUTH_DOMAIN=
# VITE_DEMO_FIREBASE_PROJECT_ID=
# VITE_DEMO_FIREBASE_STORAGE_BUCKET=
# VITE_DEMO_FIREBASE_MESSAGING_SENDER_ID=
# VITE_DEMO_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# Environment Identifier (RECOMMENDED)
# ------------------------------------------------------------------------------
# Helps distinguish between environments in monitoring/logging
# Values: development, staging, production

NODE_ENV=development

# ------------------------------------------------------------------------------
# Application Configuration (OPTIONAL)
# ------------------------------------------------------------------------------

# Feature flags (enable/disable features per environment)
# Many flags default on in development and off in production via src/config/features.ts.
# Set them explicitly here only when you want to override that default behavior.
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG_LOGS=false
VITE_ENABLE_LEAD_CONVERT=true
VITE_ENABLE_PAY_NOW=false

# Import and ad-hoc reporting exports are usable in-repo
VITE_ENABLE_IMPORT_EXPORT=true
VITE_ENABLE_ADVANCED_REPORTING=true
VITE_ENABLE_REPORT_SAVED_VIEWS=true

# Rollout-sensitive features: keep disabled until their supporting backend/provider setup is ready
VITE_ENABLE_AUTOMATION=false
VITE_ENABLE_SEQUENCES=false
VITE_ENABLE_GOALS=false
VITE_ENABLE_FORECASTING=false
VITE_ENABLE_WEB_FORMS=false
VITE_ENABLE_SMS=false
VITE_ENABLE_PUSH_NOTIFICATIONS=false
VITE_ENABLE_DASHBOARDS=false
VITE_ENABLE_SCHEDULED_REPORTS=false
VITE_ENABLE_API=false
VITE_ENABLE_WEBHOOKS=false
VITE_ENABLE_ROUTE_PLANNING=true
VITE_ENABLE_DOCUMENTS=true
VITE_ENABLE_ESIGNATURE=false
VITE_ENABLE_AUTO_WIN_ON_SIGNED_PROPOSAL=false
VITE_ENABLE_DUPLICATE_PREVENTION=true

# API endpoints (if using external services)
# VITE_API_BASE_URL=https://api.example.com
# Reporting aggregation endpoint (Cloud Function URL)
VITE_REPORTING_ENDPOINT_URL=

# App base URL used in generated links and digests
VITE_APP_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Email Service Configuration (REQUIRED for email features)
# ------------------------------------------------------------------------------
# Cloud Function endpoints for secure email sending
# These endpoints handle SendGrid integration server-side (API key stays secure)

# Cloud Function URL for sending emails
# Example: https://us-central1-your-project.cloudfunctions.net/sendEmail
VITE_EMAIL_FUNCTION_URL=

# Cloud Function URL for webhook processing (optional, for tracking)
# Example: https://us-central1-your-project.cloudfunctions.net/sendgridWebhook
VITE_EMAIL_WEBHOOK_URL=

# Default "from" email address (must be verified in SendGrid)
VITE_SENDGRID_FROM_EMAIL=noreply@example.com

# Default "from" display name
VITE_SENDGRID_FROM_NAME=Your Workspace

# Portal URL for secure links in emails (NO PHI in emails, link to portal)
VITE_PORTAL_URL=https://app.example.com

# Unsubscribe URL for email opt-out links (CAN-SPAM compliance)
VITE_UNSUBSCRIBE_URL=https://app.example.com/unsubscribe

# Enable simulation mode (no actual emails sent) - for development/testing
# Set to 'true' to simulate emails, or leave empty/remove for production
# VITE_EMAIL_SIMULATION=true

# ------------------------------------------------------------------------------
# Calendar Sync Configuration (REQUIRED for calendar provider features)
# ------------------------------------------------------------------------------

# Optional frontend OAuth metadata used by the calendar connect flows
VITE_GOOGLE_CALENDAR_CLIENT_ID=
VITE_GOOGLE_CALENDAR_REDIRECT_URI=
VITE_OUTLOOK_CLIENT_ID=
VITE_OUTLOOK_REDIRECT_URI=

# ------------------------------------------------------------------------------
# SMS / Push Configuration (REQUIRED for messaging features)
# ------------------------------------------------------------------------------

VITE_SMS_FUNCTION_URL=
VITE_SMS_WEBHOOK_URL=
VITE_TWILIO_FROM_NUMBER=
VITE_TWILIO_MESSAGING_SERVICE_SID=
# VITE_SMS_SIMULATION=true

# Web Push public key (safe to expose client-side)
VITE_VAPID_PUBLIC_KEY=

# ------------------------------------------------------------------------------
# Security Notes for Production
# ------------------------------------------------------------------------------
#
# HTTPS/TLS:
# - Firebase automatically enforces HTTPS for all connections
# - Firestore, Auth, and Storage use TLS 1.2+ by default
# - No additional configuration needed for encryption in transit
#
# CORS:
# - Firebase Console → Authentication → Settings → Authorized domains
# - Only add your real app domains (for example: admin.example.com and app.example.com)
# - NEVER use wildcard (*) origins
#
# JWT/Authentication:
# - Firebase Auth automatically generates and validates JWTs
# - Tokens include businessId in custom claims
# - Firestore rules enforce tenant isolation using request.auth
# - No manual JWT configuration needed
#
# Environment Variable Security:
# - Only VITE_ prefixed variables are exposed to client bundle
# - Server-side secrets (if any) should NOT have VITE_ prefix
# - Vite build process strips non-VITE_ variables automatically
#
# Required for Production:
# - All VITE_FIREBASE_* variables must be set with real values
# - Placeholder values (your-api-key, etc.) will fail validation
# - Run: npx tsx scripts/validate-env.ts before deploying
#
# ==============================================================================
