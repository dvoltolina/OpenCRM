{
  "main": "lib/index.js",
  "scripts": {
    "genkit:start": "genkit start -- tsx --watch src/genkit-sample.ts",
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc && npm run copy-templates",
    "copy-templates": "cp -r src/templates lib/",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:crm": "tsx --test test/crm.test.ts",
    "test:encryption-auth": "tsx --test test/encryption.authorization.test.ts",
    "test:marketing": "tsx --test test/marketing.test.ts",
    "test:public": "tsx --test test/publicBooking.test.ts",
    "test:roles": "tsx --test test/roleUtils.test.ts",
    "test": "npm run test:crm && npm run test:public && npm run test:roles && npm run test:marketing && npm run test:encryption-auth"
  },
  "name": "functions",
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.1",
    "@aws-sdk/client-sesv2": "^3.676.0",
    "@aws-sdk/client-sns": "^3.676.0",
    "@genkit-ai/firebase": "^1.24.0",
    "@google-cloud/kms": "^4.5.0",
    "@sendgrid/mail": "^8.1.0",
    "express": "^5.1.0",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.0.1",
    "genkit": "^1.24.0",
    "handlebars": "^4.7.8",
    "pdfkit": "^0.15.0",
    "stripe": "^17.4.0",
    "twilio": "^5.2.5",
    "ulidx": "^2.4.1"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.13.8",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.1.0",
    "firebase-tools": "^14.26.0",
    "genkit-cli": "^1.24.0",
    "picomatch": "^4.0.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0"
}
