# ============================================
# Firebase Cloud Functions - Environment Variables
# ============================================
# Copy this file to .env for local development
# For production: firebase functions:config:set key=value
# ============================================
#
# This file documents all environment variables used by Cloud Functions.
# Variables marked as [REQUIRED] must be set for the functions to work.
# Variables marked as [OPTIONAL] enable additional features when configured.
#
# ============================================

# ============================================================
# REQUIRED FOR PRODUCTION
# ============================================================

# --------------------------------------------
# Stripe Payment Integration
# --------------------------------------------
# [REQUIRED] Stripe secret key for payment processing
# Get from: https://dashboard.stripe.com/apikeys
# Use test key (sk_test_*) for development, live key (sk_live_*) for production
STRIPE_SECRET_KEY=

# [REQUIRED] Stripe webhook signing secret for webhook verification
# Get from: https://dashboard.stripe.com/webhooks
# Different for test mode vs live mode
STRIPE_WEBHOOK_SECRET=


# --------------------------------------------
# --------------------------------------------
# [REQUIRED] Encryption key for sensitive data (OAuth tokens, etc.)
# Must be a 64-character hex string for AES-256 encryption
# Generate with: openssl rand -hex 32
# This key is used to encrypt all OAuth tokens before storing in Firestore
ENCRYPTION_KEY=

# [OPTIONAL] Google Cloud KMS configuration for advanced encryption
# If using Cloud KMS instead of local encryption key
# GCP_PROJECT_ID=your-gcp-project-id
# KMS_LOCATION=us-central1
# KMS_KEY_RING=scheduler-keys
# KMS_KEY_NAME=master-key


# ============================================================
# EMAIL SERVICES (Choose one or both)
# ============================================================

# --------------------------------------------
# SendGrid Email Service
# --------------------------------------------
# [REQUIRED if using SendGrid]
# Get from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=


# --------------------------------------------
# AWS SES Email Service (Alternative to SendGrid)
# --------------------------------------------
# [REQUIRED if using AWS SES]
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=


# ============================================================
# SMS SERVICES (Choose one or both)
# ============================================================

# --------------------------------------------
# Twilio SMS Service
# --------------------------------------------
# [REQUIRED if using Twilio]
# Get from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# [OPTIONAL] Twilio Messaging Service SID (for advanced features)
# TWILIO_MESSAGING_SERVICE_SID=MG


# --------------------------------------------
# AWS SNS SMS Service (Alternative to Twilio)
# --------------------------------------------
# [REQUIRED if using AWS SNS]
AWS_SNS_REGION=us-east-1
AWS_SNS_ACCESS_KEY_ID=
AWS_SNS_SECRET_ACCESS_KEY=


# ============================================================
# OAUTH INTEGRATIONS
# ============================================================

# --------------------------------------------
# Google OAuth (Calendar Sync)
# --------------------------------------------
# [REQUIRED for Google Calendar integration]
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=


# --------------------------------------------
# Microsoft OAuth (Outlook Calendar Sync)
# --------------------------------------------
# [REQUIRED for Microsoft Calendar integration]
# Get from: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common


# --------------------------------------------
# Zoom (Telehealth)
# --------------------------------------------
# [REQUIRED for Zoom integration]
# Get from: https://marketplace.zoom.us/develop/create
ZOOM_ACCOUNT_ID=<your-zoom-account-id>
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=


# --------------------------------------------
# QuickBooks Online (Accounting)
# --------------------------------------------
# [REQUIRED for QuickBooks integration]
# Note: QuickBooks offers BAA (Business Associate Agreement) for HIPAA compliance
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# [OPTIONAL] QuickBooks environment (production or sandbox)
# QUICKBOOKS_ENVIRONMENT=production


# --------------------------------------------
# Xero (Accounting)
# --------------------------------------------
# [REQUIRED for Xero integration]
# Get from: https://developer.xero.com/myapps
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=


# ============================================================
# OPTIONAL INTEGRATIONS
# ============================================================

# --------------------------------------------
# AWS General Configuration
# --------------------------------------------
# [OPTIONAL] General AWS configuration (if using multiple AWS services)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=<your-aws-access-key-id>
# AWS_SECRET_ACCESS_KEY=<your-aws-secret-access-key>


# ============================================================
# APPLICATION SETTINGS
# ============================================================

# --------------------------------------------
# Environment Configuration
# --------------------------------------------
# Node Environment (development, staging, production)
NODE_ENV=development

# Application Environment (dev, staging, prod)
APP_ENV=development

# Enable debug mode (true/false)
DEBUG=true

# Logging Level (debug, info, warning, error)
LOG_LEVEL=debug


# --------------------------------------------
# CORS Configuration
# --------------------------------------------
# [REQUIRED in Production] Allowed origins for CORS (comma-separated)
# Default: https://admin.example.com,https://app.example.com,https://crm.example.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080


# --------------------------------------------
# Firebase/Google Cloud Configuration
# --------------------------------------------
# [OPTIONAL] These are usually auto-detected from Firebase environment
# Only set if you need to override defaults

# Google Cloud Project ID
# GCLOUD_PROJECT=your-gcp-project-id

# Firebase Project ID
# FIREBASE_PROJECT_ID=your-firebase-project-id

# Google Application Credentials path (for local development)
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json


# ============================================================
# SECURITY NOTES
# ============================================================
#
# CRITICAL SECURITY REQUIREMENTS:
# - NEVER commit .env files with real values to version control
# - NEVER commit .env to git (ensure it's in .gitignore)
# - Use different keys for dev/staging/production environments
# - Rotate all secrets regularly (recommended: every 90 days)
#
# ENCRYPTION REQUIREMENTS:
# - ENCRYPTION_KEY must be exactly 64 hex characters (32 bytes)
# - All OAuth tokens are encrypted before storage in Firestore
# - Functions will fail closed if ENCRYPTION_KEY is missing/invalid
# - This prevents accidental storage of plaintext tokens
#
# STRIPE SECURITY:
# - Use test keys (sk_test_*) for development
# - Use live keys (sk_live_*) for production
# - Webhook secrets are different for test mode vs live mode
# - Never expose secret keys in client-side code
#
# AWS CREDENTIALS:
# - Use IAM roles with least-privilege policies
# - Create separate IAM users for SES and SNS
# - Enable MFA on AWS root account
# - Rotate access keys every 90 days
#
# OAUTH SECURITY:
# - Tokens are encrypted at rest using ENCRYPTION_KEY
# - Tokens are refreshed automatically before expiration
# - Failed authentications trigger security audit logs
# - Cross-tenant access is blocked by authentication middleware
#
# HIPAA COMPLIANCE:
# - OAuth tokens containing PHI are encrypted at rest
# - All API calls are authenticated and authorized
# - Audit logs are generated for all sensitive operations
# - QuickBooks BAA must be signed for PHI sync
# - Xero does not offer BAA (PHI sync disabled)
#
# PRODUCTION DEPLOYMENT:
# For production, set these via Firebase CLI instead of .env:
#   firebase functions:config:set stripe.secret_key="sk_live_..."
#   firebase functions:config:set stripe.webhook_secret="whsec_..."
#   firebase functions:config:set encryption.key="your-64-char-hex-key"
#   firebase functions:config:set sendgrid.api_key="SG...."
#
# Then deploy:
#   firebase deploy --only functions
#
# FIRESTORE SECURITY RULES:
# - Ensure Firestore security rules are deployed
# - Verify client-side rules prevent unauthorized access
# - Test security rules before production deployment
#
# For detailed security hardening, see:
#
# ============================================================
# KEY ROTATION SCHEDULE
# ============================================================
#
# RECOMMENDED ROTATION INTERVALS:
# - Stripe keys: On security breach or every 12 months
# - SendGrid/Twilio: Every 90 days
# - OAuth credentials: Every 90 days
# - ENCRYPTION_KEY: Every 12 months (requires data re-encryption)
# - AWS credentials: Every 90 days
#
# ENCRYPTION KEY ROTATION PROCEDURE:
# 1. Generate new ENCRYPTION_KEY
# 2. Deploy new key to all environments
# 3. Re-encrypt all stored tokens with new key
# 4. Verify all tokens decrypt successfully
# 5. Remove old key from all environments
#
#
# ============================================================
# FIREBASE FUNCTIONS CONFIG COMMANDS
# ============================================================
#
# List all config:
#   firebase functions:config:get
#
# Set a value:
#   firebase functions:config:set key.subkey="value"
#
# Unset a value:
#   firebase functions:config:unset key.subkey
#
# Clone config between projects:
#   firebase functions:config:get > config.json
#   firebase --project another-project functions:config:set --from config.json
#
# ============================================================
