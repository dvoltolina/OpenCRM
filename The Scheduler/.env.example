# ============================================
# The Scheduler - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================
#
# This file documents all environment variables used by The Scheduler app.
# Variables marked as [REQUIRED] must be set for the application to function.
# Variables marked as [OPTIONAL] enable additional features when configured.
#
# ============================================

# --------------------------------------------
# Flutter Build Configuration
# --------------------------------------------
# These are passed via --dart-define during build
# Example: flutter build apk --dart-define=ENV=prod

# Environment (dev, staging, prod)
# Controls which Firebase project and API endpoints to use
ENV=dev

# Firebase project override (optional)
# If set, overrides the default project ID from EnvironmentConfig
# FIREBASE_PROJECT=your-firebase-project


# --------------------------------------------
# AI & Predictive Intelligence Services
# --------------------------------------------
# PHI never leaves local infrastructure

# [REQUIRED] Base URL for AI server (local or VPN/Tailscale URL)
AI_BASE_URL=http://localhost:8000

# [OPTIONAL] Dedicated service URLs (for distributed deployment)
# AI_PREDICTION_SERVICE_URL=http://localhost:8000
# AI_SENTIMENT_SERVICE_URL=https://runpod-xxx-8002.proxy.runpod.net
# AI_ROUTE_SERVICE_URL=http://localhost:8001

# [REQUIRED in Production] API key for AI service authentication
# Format: "key:business_id" for tenant isolation
# AI_API_KEY=your-secure-api-key:business_123

# [OPTIONAL] JWT token for AI service (preferred over API key)
# AI_AUTH_TOKEN=your-jwt-token

# [REQUIRED in Production] Enforce HTTPS for AI connections
# Set to false only for local development
AI_REQUIRE_HTTPS=true

# AI External Providers (Routing/Sentiment)
# Routing: Google Routes API key and optional region override
GOOGLE_ROUTES_API_KEY=
GOOGLE_ROUTES_REGION=us-west1

# Sentiment: Google NL service account path + OpenAI override (optional)
# Mount service account JSON read-only and point GOOGLE_APPLICATION_CREDENTIALS to it
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-sa.json
GCLOUD_PROJECT=
OPENAI_API_KEY=
SENTIMENT_PROVIDER=google_nl  # google_nl | openai | ollama | vader
SENTIMENT_MODEL=gpt-4o-mini
SENTIMENT_LANGUAGE=en


# --------------------------------------------
# Third-Party Integrations - Authentication
# --------------------------------------------

# === Google OAuth (Calendar Sync) ===
# [REQUIRED for Google Calendar integration]
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=com.scheduler.app:/oauth2redirect/google

# === Microsoft OAuth (Outlook Calendar Sync) ===
# [REQUIRED for Microsoft Calendar integration]
# Get from: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=msauth.com.scheduler.app://auth
# MICROSOFT_TENANT_ID=common

# === Zoom (Telehealth) ===
# [REQUIRED for Zoom integration]
# Get from: https://marketplace.zoom.us/develop/create
ZOOM_ACCOUNT_ID=<your-zoom-account-id>
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# === QuickBooks Online (Accounting) ===
# [REQUIRED for QuickBooks integration]
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=https://app.example.com/oauth/quickbooks/callback

# === Xero (Accounting) ===
# [REQUIRED for Xero integration]
# Get from: https://developer.xero.com/myapps
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=https://app.example.com/oauth/xero/callback


# --------------------------------------------
# Integration Token Encryption
# --------------------------------------------
# [REQUIRED] Encryption key for storing OAuth tokens securely
# Must be at least 32 characters for AES-256 encryption
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=


# --------------------------------------------
# Default Provider Selection
# --------------------------------------------
# Configure which providers to use by default

# Email Provider (sendGrid, awsSes, mock)
EMAIL_PROVIDER=sendGrid

# SMS Provider (twilio, awsSns, mock)
SMS_PROVIDER=twilio

# Default Telehealth Provider (zoom, googleMeet, none)
DEFAULT_TELEHEALTH_PROVIDER=zoom


# --------------------------------------------
# Email Service Providers
# --------------------------------------------

# === SendGrid ===
# [REQUIRED if EMAIL_PROVIDER=sendGrid]
# Get from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=

# === AWS SES (Alternative to SendGrid) ===
# [REQUIRED if EMAIL_PROVIDER=awsSes]
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=


# --------------------------------------------
# SMS Service Providers
# --------------------------------------------

# === Twilio ===
# [REQUIRED if SMS_PROVIDER=twilio]
# Get from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=<your-twilio-phone-number>
# TWILIO_MESSAGING_SERVICE_SID=<optional-messaging-service-sid>

# === AWS SNS (Alternative to Twilio) ===
# [REQUIRED if SMS_PROVIDER=awsSns]
AWS_SNS_REGION=us-east-1
AWS_SNS_ACCESS_KEY_ID=
AWS_SNS_SECRET_ACCESS_KEY=


# --------------------------------------------
# Application Configuration
# --------------------------------------------

# Application Environment (development, staging, production)
APP_ENV=development

# Enable debug mode (true/false)
DEBUG=true

# Logging Level (debug, info, warning, error)
LOG_LEVEL=debug


# ============================================
# SECURITY & COMPLIANCE NOTES
# ============================================
#
# HIPAA COMPLIANCE:
# - OAuth tokens are encrypted at rest using TOKEN_ENCRYPTION_KEY
# - AI services run on local infrastructure only
# - No PHI is sent to third-party cloud services
#
# PRODUCTION CHECKLIST:
# 1. Set ENV=prod
# 2. Set DEBUG=false
# 3. Set LOG_LEVEL=warning or error
# 4. Set AI_REQUIRE_HTTPS=true
# 5. Configure all REQUIRED variables for enabled features
# 6. Use strong, randomly generated keys (never reuse keys)
# 7. Rotate secrets every 90 days
# 8. Ensure .env is in .gitignore
#
# KEY ROTATION:
# - Stripe keys: Rotate via Stripe Dashboard
# - SendGrid/Twilio: Rotate via provider dashboard
# - OAuth credentials: Rotate via provider console
#
# For detailed security hardening, see:
#
# ============================================
