{
  "name": "the-scheduler-firestore-rules-tests",
  "version": "1.0.0",
  "description": "Firestore Security Rules Tests for The Scheduler",
  "scripts": {
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:emulator": "firebase emulators:exec --config ../../firebase.test.json --only firestore \"npm test\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.0",
    "firebase": "^10.7.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "verbose": true,
    "testMatch": [
      "**/*.test.js"
    ]
  },
  "license": "SEE LICENSE IN LICENSE"
}
