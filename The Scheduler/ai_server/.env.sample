# AI Server Environment Template (Routing + Sentiment)
# Copy to ai_server/.env and fill in per-environment values.
# No secrets should be committed. Mount service account files read-only.

# -------------------------
# Shared / Security
# -------------------------
AI_SERVICE_API_KEY=
JWT_PUBLIC_KEY=
JWT_SECRET=

# -------------------------
# Routing (Google Routes + fallbacks)
# -------------------------
ROUTING_PROVIDER=google                    # google | osrm | haversine
GOOGLE_ROUTES_API_KEY=
GOOGLE_ROUTES_REGION=us-west1
ROUTING_API_KEY=
ROUTING_ALLOW_API_KEY_FALLBACK=
ROUTING_REQUIRE_AUTH=true                  # Disable only for local dev
ROUTING_REQUIRE_HTTPS=true                 # Set false ONLY for localhost testing
ROUTING_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# ROUTING_TRUSTED_HOSTS=api.yourdomain.com   # Comma separated; no wildcards in prod

# -------------------------
# Sentiment (Google NL / OpenAI / Ollama fallback)
# -------------------------
SENTIMENT_PROVIDER=google_nl               # google_nl | openai | ollama | vader
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-sa.json   # Mount read-only in Docker/Cloud Run
GCLOUD_PROJECT=your-gcp-project-id
OPENAI_API_KEY=
SENTIMENT_MODEL=gpt-4o-mini                # OpenAI model override
SENTIMENT_LANGUAGE=en
SENTIMENT_REQUIRE_AUTH=true
SENTIMENT_REQUIRE_HTTPS=true
SENTIMENT_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
SENTIMENT_ALLOW_API_KEY_FALLBACK=

# -------------------------
# Local Dev Overrides
# -------------------------
# ROUTING_PROVIDER=osrm
# ROUTING_REQUIRE_AUTH=false
# ROUTING_REQUIRE_HTTPS=false
# SENTIMENT_PROVIDER=ollama
# SENTIMENT_REQUIRE_AUTH=false
# SENTIMENT_REQUIRE_HTTPS=false
