# ============================================================
# The Scheduler AI Services - Environment Configuration
# Agent AI-13: Docker & Cloud Deployment
# ============================================================
#
# Copy this file to .env and configure for your environment.
# NEVER commit .env to version control!
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   docker compose up -d

# ============================================================
# GLOBAL SETTINGS
# ============================================================

# CORS allowed origins (comma-separated)
# Development:
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Production (set via PROD_CORS_ORIGINS):
# PROD_CORS_ORIGINS=https://app.yourscheduler.com,https://admin.yourscheduler.com

# ============================================================
# PREDICTION SERVICE (Port 8001)
# ============================================================
# No-show prediction using LightGBM

# Service port (default: 8001)
PREDICTION_PORT=8001

# Enable debug mode (default: false)
PREDICTION_DEBUG=false

# Logging level: DEBUG, INFO, WARNING, ERROR
PREDICTION_LOG_LEVEL=INFO

# Authentication (REQUIRED in production for HIPAA)
PREDICTION_REQUIRE_AUTH=false
# API keys - format: "key:business_id" or "key" for admin
# Example: PREDICTION_API_KEYS=abc123:business_001,def456:business_002,admin_key_xyz
PREDICTION_API_KEYS=

# Prediction thresholds (must match Flutter AIConfig)
PREDICTION_HIGH_RISK_THRESHOLD=0.7
PREDICTION_MEDIUM_RISK_THRESHOLD=0.4

# Rate limiting (requests per minute per API key)
PREDICTION_RATE_LIMIT=120

# ============================================================
# SENTIMENT SERVICE (Port 8002)
# ============================================================
# Sentiment analysis using Ollama LLM

# Service port (default: 8002)
SENTIMENT_PORT=8002

# Enable debug mode (default: false)
SENTIMENT_DEBUG=false

# Logging level: DEBUG, INFO, WARNING, ERROR
SENTIMENT_LOG_LEVEL=INFO

# Ollama LLM models
# phi3:mini (~8GB VRAM, ~200ms latency) - default
# llama3.1:8b (~16GB VRAM, ~800ms latency) - deep analysis
SENTIMENT_DEFAULT_MODEL=phi3:mini
SENTIMENT_DEEP_MODEL=llama3.1:8b

# Authentication (REQUIRED in production for HIPAA)
SENTIMENT_REQUIRE_AUTH=false
# API keys - format: "key:business_id" or "key" for admin
SENTIMENT_API_KEYS=

# Rate limiting (requests per minute per API key)
SENTIMENT_RATE_LIMIT=60

# HIPAA: Redact trigger text from responses in production
# SENTIMENT_REDACT_TRIGGER_TEXT=true

# ============================================================
# ROUTING SERVICE (Port 8003)
# ============================================================
# Route optimization using OR-Tools + OSRM

# Service port (default: 8003)
ROUTING_PORT=8003

# Enable debug mode (default: false)
ROUTING_DEBUG=false

# Logging level: DEBUG, INFO, WARNING, ERROR
ROUTING_LOG_LEVEL=INFO

# OSRM timeout in seconds
ROUTING_OSRM_TIMEOUT=30

# OR-Tools solver timeout in seconds
ROUTING_SOLVER_TIMEOUT=30

# Authentication (REQUIRED in production for HIPAA)
ROUTING_REQUIRE_AUTH=false
# Single API key for routing service
ROUTING_API_KEY=

# Enable OpenAPI docs (disable in production)
ROUTING_ENABLE_DOCS=true

# Rate limiting (requests per minute)
ROUTING_RATE_LIMIT=60

# ============================================================
# OSRM (Port 5000)
# ============================================================
# Open Source Routing Machine for driving directions

# Service port (default: 5000)
OSRM_PORT=5000

# Region name - must match processed OSM data file
# Options: us-west, us-east, us-central, europe, etc.
# Run scripts/setup-osrm.sh to download and process data
OSRM_REGION=us-west

# ============================================================
# OLLAMA (Port 11434)
# ============================================================
# Local LLM runtime for sentiment analysis

# Service port (default: 11434)
OLLAMA_PORT=11434

# ============================================================
# CLOUD DEPLOYMENT (Optional)
# ============================================================

# Google Cloud Project ID (for Cloud Run)
GCP_PROJECT_ID=your-project-id

# Google Cloud Region
GCP_REGION=us-central1

# Container Registry (gcr.io or Artifact Registry)
CONTAINER_REGISTRY=gcr.io/${GCP_PROJECT_ID}

# Cloud Run service names
PREDICTION_SERVICE_NAME=scheduler-prediction
ROUTING_SERVICE_NAME=scheduler-routing

# RunPod API key (for sentiment GPU deployment)
RUNPOD_API_KEY=

# ============================================================
# MONITORING & ALERTS (Optional)
# ============================================================

# Sentry DSN for error tracking
# SENTRY_DSN=https://xxx@example.com/xxx

# DataDog API key for metrics
# DATADOG_API_KEY=xxx

# PagerDuty integration key for alerts
# PAGERDUTY_KEY=xxx
